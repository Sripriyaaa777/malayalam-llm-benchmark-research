# Malayalam LLM Benchmark — API Keys
# Copy this file to .env and fill in your keys.

# ── Groq (free tier — covers Llama 3.3, Llama 4, Gemma 2, Qwen 3) ──────────
# Get key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# ── Mistral AI (free tier — covers Mistral Large) ────────────────────────────
# Get key: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your_mistral_key_here

# ── Google AI Studio (free tier — covers Gemini 2.5 Flash) ──────────────────
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here
